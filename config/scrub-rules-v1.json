{
  "version": "v1",
  "note": "denylist 규칙. allowlist(허용 문자·길이·구조)는 S3-1 이 별도 파일로 더한다.",
  "rules": [
    {"id": "email",        "kind": "이메일 형태",        "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"},
    {"id": "phone-intl",   "kind": "국제 전화 형태",      "pattern": "\\+[0-9]{1,3}[- ]?[0-9]{2,4}[- ]?[0-9]{3,4}[- ]?[0-9]{4}"},
    {"id": "phone-kr",     "kind": "국내 전화 형태",      "pattern": "\\b01[0-9][- ]?[0-9]{3,4}[- ]?[0-9]{4}\\b"},
    {"id": "national-id",  "kind": "주민등록번호 형태",    "pattern": "\\b[0-9]{6}[- ][1-4][0-9]{6}\\b"},
    {"id": "card",         "kind": "카드번호 형태",       "pattern": "\\b[0-9]{4}[- ][0-9]{4}[- ][0-9]{4}[- ][0-9]{4}\\b"},
    {"id": "account",      "kind": "계좌번호 형태",       "pattern": "\\b[0-9]{2,6}-[0-9]{2,6}-[0-9]{4,8}\\b"},
    {"id": "key-openai",   "kind": "비밀키 형태(sk-)",    "pattern": "\\bsk-[A-Za-z0-9_-]{16,}"},
    {"id": "key-github",   "kind": "비밀키 형태(gh)",     "pattern": "\\bgh[pousr]_[A-Za-z0-9]{20,}"},
    {"id": "key-aws",      "kind": "비밀키 형태(AKIA)",   "pattern": "\\bAKIA[0-9A-Z]{16}\\b"},
    {"id": "key-slack",    "kind": "비밀키 형태(xox)",    "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}"},
    {"id": "key-jwt",      "kind": "토큰 형태(JWT)",      "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"},
    {"id": "key-private",  "kind": "개인키 블록",         "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"},
    {"id": "path-posix",   "kind": "절대 경로(POSIX)",    "pattern": "(?<![A-Za-z0-9._-])/(Users|home)/[A-Za-z0-9._-]+"},
    {"id": "path-windows", "kind": "절대 경로(Windows)",  "pattern": "[A-Za-z]:\\\\\\\\Users\\\\\\\\[A-Za-z0-9._-]+"},
    {"id": "path-home",    "kind": "홈 경로 표기",        "pattern": "(?<![A-Za-z0-9])~/[A-Za-z0-9._/-]+"},
    {"id": "ip-private",   "kind": "사설 IP",            "pattern": "\\b(10\\.[0-9]{1,3}|192\\.168|172\\.(1[6-9]|2[0-9]|3[01]))\\.[0-9]{1,3}\\.[0-9]{1,3}\\b"},
    {"id": "ip-loopback",  "kind": "루프백 IP",          "pattern": "\\b127\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\b"}
  ]
}
