<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 우리 이름 글 탐지기 1단계 — 1시간마다(설계 DESIGN-v3 §6-2 · master Q1=A 판정 2026-09-29).
     읽기만 한다(공개 GET). 알림 = 상태가 바뀔 때만 master 인박스 한 줄(--notify).
     ⚠스크립트 경로 = 구현 작업트리. 갈래가 병합돼 이 경로가 사라지면 생존 작업(detect-liveness)이 「스크립트 없음」을 알린다 → 경로를 옮겨 다시 설치. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>kr.godmeyou.agora.detect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/oogisoogi/axdev/.wt/agora-admission/tools/detect_ours.py</string>
    <string>scan</string>
    <string>--notify</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/oogisoogi/axdev/.wt/agora-admission</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/oogisoogi</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/oogisoogi/.local/state/agora-detect/detect.log</string>
  <key>StandardErrorPath</key><string>/Users/oogisoogi/.local/state/agora-detect/detect.log</string>
</dict>
</plist>
